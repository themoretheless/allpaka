+/// with what the host reads at the same address. The command-buffer verdict
+/// says the driver refused a mapping; this asks whether one it accepted
+/// resolves to the bytes it was built from. `WINDOW_THREADS * WINDOW_SAMPLES`
+/// reads per window, so the check is a statement about whole windows: a single
+/// wrong page inside a 4 GiB window escapes it with probability 1 - 256/262144.
+pub fn check_windows() -> (usize, Option<String>) {
+    const WINDOW_THREADS: usize = 32;
+    const WINDOW_SAMPLES: u32 = 8;
+    const PAGE: usize = 16384;
+    let Some(Some(cell)) = GPU.get() else {
+        return (0, Some("no device".to_string()));
+    };
+    let mut gpu = match cell.lock() {
+        Ok(g) => g,
+        Err(_) => return (0, Some("gpu mutex poisoned".to_string())),
+    };
+    let nwin = gpu.chunks.iter().filter(|c| c.len / PAGE > 0).count();
+    if nwin == 0 {
+        return (0, Some("no windows are attached".to_string()));
+    }
+    let Some(state) = gpu.pipeline("window_check", 1, 1).map(|s| s.to_owned()) else {
+        return (0, Some("window_check pipeline is missing".to_string()));
+    };
+    let out = gpu
+        .device
+        .new_buffer((nwin * WINDOW_THREADS * 4) as u64, MTLResourceOptions::StorageModeShared);
+    let mut ci = 0usize;
+    objc::rc::autoreleasepool(|| {
+        let cmd = gpu.queue.new_command_buffer();
+        let enc =
+            cmd.compute_command_encoder_with_dispatch_type(metal::MTLDispatchType::Concurrent);
+        enc.set_compute_pipeline_state(&state);
+        enc.set_buffer(1, Some(&out), 0);
+        for ch in gpu.chunks.iter() {
+            let npages = (ch.len / PAGE) as u32;
+            if npages == 0 {
+                continue;
+            }
+            let base = (ci * WINDOW_THREADS) as u32;
+            ci += 1;
+            enc.set_buffer(0, Some(&ch.buf), 0);
+            enc.set_bytes(2, 4, &npages as *const u32 as *const _);
+            enc.set_bytes(3, 4, &base as *const u32 as *const _);
+            enc.dispatch_threads(
+                metal::MTLSize::new(WINDOW_THREADS as u64, 1, 1),
+                metal::MTLSize::new(WINDOW_THREADS as u64, 1, 1),
+            );
+        }
+        enc.end_encoding();
+        cmd.commit();
+        cmd.wait_until_completed();
+        note_gpu_times(cmd);
+    });
+    let mut got = vec![0u32; nwin * WINDOW_THREADS];
+    unsafe {
+        std::ptr::copy_nonoverlapping(out.contents() as *const u32, got.as_mut_ptr(), got.len());
+    }
+    let mut samples = 0usize;
+    let mut slot = 0usize;
+    for (w, ch) in gpu.chunks.iter().enumerate() {
+        let npages = (ch.len / PAGE) as u32;
+        if npages == 0 {
+            continue;
+        }
+        for t in 0..WINDOW_THREADS {
+            let mut expect = 0u32;
+            for sm in 0..WINDOW_SAMPLES {
+                let page = sm
+                    .wrapping_mul(2654435761)
+                    .wrapping_add((t as u32).wrapping_mul(40503))
+                    % npages;
+                expect = expect.wrapping_add(
+                    unsafe { *((ch.start + page as usize * PAGE) as *const u8) } as u32,
+                );
+            }
+            samples += 1;
+            let read = got[slot * WINDOW_THREADS + t];
+            if read != expect {
+                return (
+                    samples,
+                    Some(format!(
+                        "window {w} ({} GiB at {:#x}) thread {t}: the GPU read {read}, the host \
+                         read {expect} at the same addresses",
+                        ch.len / (1 << 30),
+                        ch.start
+                    )),
+                );
+            }
+        }
+        slot += 1;
+    }
+    (samples, None)
