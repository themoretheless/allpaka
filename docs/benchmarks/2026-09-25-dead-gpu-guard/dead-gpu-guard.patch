+#define WINDOW_SAMPLES 8u
+
+// Sample a weight window the way the GPU sees it: one byte every few pages,
+// summed, so the host can compare a whole window's worth of reads against its
+// own view of the same addresses. The kernel is bound to the window's own
+// bytesNoCopy buffer and never sees a host pointer, so a mismatch means the
+// device's page tables resolve that buffer to something other than the bytes
+// it was built from. The index arithmetic must match WINDOW_* in Rust.
+kernel void window_check(
+    device const uchar* src [[buffer(0)]],
+    device uint* out [[buffer(1)]],
+    constant uint& npages [[buffer(2)]],
+    constant uint& base [[buffer(3)]],
+    uint tid [[thread_position_in_grid]])
+{
+    uint sum = 0u;
+    for (uint s = 0u; s < WINDOW_SAMPLES; ++s) {
+        uint page = (s * 2654435761u + tid * 40503u) % npages;
+        // 64-bit on purpose: a 32 GiB window has 2M pages, and page << 14
+        // overflows uint at 256 KiB of pages, which is 4 GiB of window.
+        sum += (uint)src[(uint64_t)page * 16384ull];
+    }
+    out[base + tid] = sum;
+}
