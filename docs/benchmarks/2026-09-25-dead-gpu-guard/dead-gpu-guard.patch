+/// Count the driver's verdict on a finished buffer. An aborted or
+/// out-of-memory command buffer leaves the reused output arena holding the
+/// previous dispatch's values, so a read-back of it looks correct; only this
+/// says the work never ran.
+fn note_cb_error(cmd: &metal::CommandBufferRef) {
+    use objc::{msg_send, sel, sel_impl};
+    let err: *mut objc::runtime::Object = unsafe { msg_send![cmd, error] };
+    if err.is_null() {
+        return;
+    }
+    let code: i64 = unsafe { msg_send![err, code] };
+    let domain: *mut objc::runtime::Object = unsafe { msg_send![err, domain] };
+    let desc: *mut objc::runtime::Object = unsafe { msg_send![err, localizedDescription] };
+    record_cb_error(format!(
+        "{}: {} (code {code})",
+        ns_to_str(domain),
+        ns_to_str(desc)
+    ));
+}
+
+/// Account for one failed buffer: every one is counted, the first is kept for
+/// the caller that reports the run, and only the first few are logged, since a
+/// run that fails does so on every dispatch.
+fn record_cb_error(detail: String) {
+    let seen = CB_ERRORS.fetch_add(1, Ordering::Relaxed);
+    if seen < 3 {
+        eprintln!("allpaka: GPU command buffer failed: {detail}");
+    }
+    if let Ok(mut first) = CB_ERROR_FIRST.lock() {
+        if first.is_none() {
+            *first = Some(detail);
+        }
+    }
+}
+
+fn ns_to_str(ns: *mut objc::runtime::Object) -> String {
+    use objc::{msg_send, sel, sel_impl};
+    if ns.is_null() {
+        return String::from("(nil)");
+    }
+    let utf: *const std::os::raw::c_char = unsafe { msg_send![ns, UTF8String] };
+    if utf.is_null() {
+        return String::from("(nil)");
+    }
+    unsafe { std::ffi::CStr::from_ptr(utf) }.to_string_lossy().into_owned()
+}
