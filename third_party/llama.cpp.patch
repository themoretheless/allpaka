diff --git a/ggml/src/ggml-cuda/convert.cu b/ggml/src/ggml-cuda/convert.cu
index 360c614..bbfe2aa 100644
--- a/ggml/src/ggml-cuda/convert.cu
+++ b/ggml/src/ggml-cuda/convert.cu
@@ -703,3 +703,18 @@ to_fp32_nc_cuda_t ggml_get_to_fp32_nc_cuda(ggml_type type) {
             return nullptr;
     }
 }
+
+extern "C" __declspec(dllexport) int allpaka_dequant_f16(
+    void * cuda_ctx_v, const void * src, void * dst, int64_t n_elem, int w_type)
+{
+    if (!cuda_ctx_v || !src || !dst || n_elem <= 0) {
+        return -2;
+    }
+    to_fp16_cuda_t fn = ggml_get_to_fp16_cuda((ggml_type) w_type);
+    if (!fn) {
+        return -3;
+    }
+    auto * ctx = static_cast<ggml_backend_cuda_context *>(cuda_ctx_v);
+    fn(src, static_cast<half *>(dst), n_elem, ctx->stream());
+    return 0;
+}
